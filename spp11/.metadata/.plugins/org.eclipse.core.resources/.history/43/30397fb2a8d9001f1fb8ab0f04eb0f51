void title_line()
{
	if (strlen(name) == 0)
	{
		HAL_UART_Transmit(&huart3, (uint8_t*)"\r\nNAME : ", 9, HAL_MAX_DELAY);
	}
	else
	{

		snprintf(tx_message, sizeof(tx_message), "\r\n%s : ", name);
	    HAL_UART_Transmit(&huart3, (uint8_t*)tx_message, strlen(tx_message), HAL_MAX_DELAY);
	}
}

void blink_led(int led)
{
	if (led == 1)
	{
		for (int i = 0; i < 6; i++)
		{
			HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_0);
			HAL_Delay(200);
		}

	}
	else if (led == 2)
	{
		for (int i = 0; i < 6; i++)
		{
			HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_7);
			HAL_Delay(200);
		}
	}
	else if (led == 3)
	{
		for (int i = 0; i < 6; i++)
		{
			HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_14);
			HAL_Delay(200);
		}
	}
}
